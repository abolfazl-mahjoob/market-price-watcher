{
  "name": "market-price-watcher",
  "version": "0.1.0",
  "description": "Independent multi-source Playwright watcher with exact decimal pricing and PostgreSQL history",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "migrate": "node scripts/migrate.mjs",
    "verify": "npm run typecheck && npm test"
  },
  "dependencies": {
    "pg": "^8.16.3",
    "playwright": "^1.55.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2"
  }
}
